{
  "name": "hendese",
  "version": "0.4.0",
  "description": "A blueprint-style design language for long-form technical pages: design tokens, layered CSS components, a scroll-scene engine and a pixel mascot.",
  "keywords": [
    "design-system",
    "css",
    "design-tokens",
    "cascade-layers",
    "blueprint",
    "technical-drawing",
    "scroll-animation",
    "scrollytelling",
    "documentation",
    "accessibility"
  ],
  "homepage": "https://github.com/Ilhanemreadak/hendese#readme",
  "bugs": {
    "url": "https://github.com/Ilhanemreadak/hendese/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ilhanemreadak/hendese.git"
  },
  "license": "MIT",
  "author": "İlhan Emre Adak",
  "private": true,
  "type": "module",
  "style": "dist/hendese.css",
  "main": "dist/hendese.esm.js",
  "module": "dist/hendese.esm.js",
  "unpkg": "dist/hendese.js",
  "jsdelivr": "dist/hendese.js",
  "exports": {
    ".": {
      "style": "./dist/hendese.css",
      "default": "./dist/hendese.esm.js"
    },
    "./css": "./dist/hendese.css",
    "./css/inline": "./dist/hendese.inline.css",
    "./package.json": "./package.json",
    "./src/*": "./src/*",
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist/",
    "src/",
    "docs/",
    "demos/",
    "starter/",
    "STANDARD.md",
    "CHANGELOG.md",
    "README.md",
    "README.tr.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=21"
  },
  "scripts": {
    "build": "node tools/build.mjs && node tools/demos.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:e2e": "playwright test",
    "test": "npm run build && npm run test:unit && npm run test:e2e",
    "release": "node tools/release.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "esbuild": "^0.28.2"
  }
}
